<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="state"><name><text>state</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>0</apn:text></apn:token></apn:valueTokens></place><place id="job"><name><text>job</text></name><graphics><position x="140" y="240"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>(0, F)</apn:text></apn:token></apn:valueTokens></place><place id="ack"><name><text>ack</text></name><graphics><position x="1000" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"/></place><place id="receipt"><name><text>receipt</text></name><graphics><position x="1000" y="240"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"/></place><place id="audit"><name><text>audit</text></name><graphics><position x="140" y="380"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>[]</apn:text></apn:token></apn:valueTokens></place><transition id="submit_1"><name><text>submit_1</text></name><graphics><position x="430" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>s == 0</apn:text></apn:guard></transition><transition id="complete_1"><name><text>complete_1</text></name><graphics><position x="690" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>s == 1 and asBool(snd(p))</apn:text></apn:guard></transition><transition id="submit_2"><name><text>submit_2</text></name><graphics><position x="430" y="330"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>s == 0</apn:text></apn:guard></transition><transition id="complete_2"><name><text>complete_2</text></name><graphics><position x="690" y="330"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>s == 2 and asBool(snd(p)) and asInt(fst(p)) &gt;= 3</apn:text></apn:guard></transition><arc id="submit_1-in-state-0" source="state" target="submit_1"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="submit_1-in-job-1" source="job" target="submit_1"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="submit_1-out-state-0" source="submit_1" target="state"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>1</apn:text></apn:binding></arc><arc id="submit_1-out-job-1" source="submit_1" target="job"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="submit_1-out-ack-2" source="submit_1" target="ack"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>true</apn:text></apn:binding></arc><arc id="complete_1-in-state-0" source="state" target="complete_1"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="complete_1-in-job-1" source="job" target="complete_1"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="complete_1-in-audit-2" source="audit" target="complete_1"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="complete_1-out-state-0" source="complete_1" target="state"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>0</apn:text></apn:binding></arc><arc id="complete_1-out-job-1" source="complete_1" target="job"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="complete_1-out-receipt-2" source="complete_1" target="receipt"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="complete_1-out-audit-3" source="complete_1" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>append(xs, 1)</apn:text></apn:binding></arc><arc id="submit_2-in-state-0" source="state" target="submit_2"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="submit_2-in-job-1" source="job" target="submit_2"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="submit_2-out-state-0" source="submit_2" target="state"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>2</apn:text></apn:binding></arc><arc id="submit_2-out-job-1" source="submit_2" target="job"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="submit_2-out-ack-2" source="submit_2" target="ack"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>true</apn:text></apn:binding></arc><arc id="complete_2-in-state-0" source="state" target="complete_2"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="complete_2-in-job-1" source="job" target="complete_2"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="complete_2-in-audit-2" source="audit" target="complete_2"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="complete_2-out-state-0" source="complete_2" target="state"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>0</apn:text></apn:binding></arc><arc id="complete_2-out-job-1" source="complete_2" target="job"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="complete_2-out-receipt-2" source="complete_2" target="receipt"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="complete_2-out-audit-3" source="complete_2" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>append(xs, 2)</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="1">{"places":[{"id":"state","sort":"Int","io_type":"internal"},{"id":"job","sort":"Pair","io_type":"internal"},{"id":"ack","sort":"Bool","io_type":"output"},{"id":"receipt","sort":"Pair","io_type":"output"},{"id":"audit","sort":"List","io_type":"internal"}],"transitions":[{"id":"submit_1","method":{"name":"submit","parameters":[{"name":"p","sort":"Pair"}]}},{"id":"complete_1","method":{"name":"complete","parameters":[]}},{"id":"submit_2","method":{"name":"submit","parameters":[{"name":"p","sort":"Pair"}]}},{"id":"complete_2","method":{"name":"complete","parameters":[]}}],"testIntentions":[{"id":"exercise-worker-service","name":"2 workers / 2 rounds / audit history","kind":"symbolic","symbolic":{"source":"operation admissible(Pair): Bool\nrule permit(n: Int): admissible((n, true)) = true if n &gt;= 1 and n &lt;= 5","variablesText":"p: Pair","argsText":"p","operation":"admissible","conditionsText":"","protocolSource":"case run(p: Pair):\ninputs p\nresult true\npair submit(p=p) =&gt; ack(true)\npair complete() =&gt; receipt(p)","maxDepth":4},"branchingProperty":{"op":"box","stimulation":{"method":"submit","arguments":{"p":"$p"}},"child":{"op":"diamond","stimulation":{"method":"complete","arguments":{}},"observation":{"outputs":{"receipt":["$p"]}},"child":{"op":"box","stimulation":{"method":"submit","arguments":{"p":"$p"}},"child":{"op":"diamond","stimulation":{"method":"complete","arguments":{}},"observation":{"outputs":{"receipt":["$p"]}},"child":{"op":"true"}}}}}}],"satelExample":{"id":"scale-workers-2-2-true-reference","name":"Replicated worker service","role":"reference","description":"A shared job must complete regardless of which worker accepts it. Optional append-only audit retains the worker history."}}</apn:satel></net></pnml>