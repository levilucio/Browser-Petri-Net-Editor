blesText":"q: Int","argsText":"q","operation":"offer","conditionsText":"","protocolSource":"case run(q: Int):\ninputs q\nresult true\npair reserve(w=0, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=0) =&gt; ack(true)\npair dispatch(w=0) =&gt; ack(true)\npair deliver(w=0) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=0) =&gt; ack(true)\npair reserve(w=1, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=1) =&gt; ack(true)\npair dispatch(w=1) =&gt; ack(true)\npair deliver(w=1) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=1) =&gt; ack(true)\npair reserve(w=2, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=2) =&gt; ack(true)\npair dispatch(w=2) =&gt; ack(true)\npair deliver(w=2) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=2) =&gt; ack(true)\npair reserve(w=3, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=3) =&gt; ack(true)\npair dispatch(w=3) =&gt; ack(true)\npair deliver(w=3) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=3) =&gt; ack(true)","maxDepth":4}}],"satelExample":{"id":"scale-fulfilment-4-8-4-stock-leak","role":"mutant","name":"Regional fulfilment","description":"Independent regional stock, wallet, permit and resource policies; continuous reserve/pack/dispatch/deliver/settle lifecycle."}}</apn:satel></net></pnml>