":[{"name":"w","sort":"Nat"}]}},{"id":"deliver_126","method":{"name":"deliver","parameters":[{"name":"w","sort":"Nat"}]}},{"id":"settle_126","method":{"name":"settle","parameters":[{"name":"w","sort":"Nat"}]}},{"id":"reserve_127","method":{"name":"reserve","parameters":[{"name":"w","sort":"Nat"},{"name":"q","sort":"Int"},{"name":"label","sort":"String"}]}},{"id":"pack_127","method":{"name":"pack","parameters":[{"name":"w","sort":"Nat"}]}},{"id":"dispatch_127","method":{"name":"dispatch","parameters":[{"name":"w","sort":"Nat"}]}},{"id":"deliver_127","method":{"name":"deliver","parameters":[{"name":"w","sort":"Nat"}]}},{"id":"settle_127","method":{"name":"settle","parameters":[{"name":"w","sort":"Nat"}]}}],"testIntentions":[{"id":"exercise-regional-fulfilment","name":"Regional fulfilment: 128 sites / 20 pairs","kind":"symbolic","symbolic":{"source":"operation offer(Int): Bool\nrule quantity(q: Int): offer(q) = true if q &gt;= 1 and q &lt;= 5","variablesText":"q: Int","argsText":"q","operation":"offer","conditionsText":"","protocolSource":"case run(q: Int):\ninputs q\nresult true\npair reserve(w=0, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=0) =&gt; ack(true)\npair dispatch(w=0) =&gt; ack(true)\npair deliver(w=0) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=0) =&gt; ack(true)\npair reserve(w=1, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=1) =&gt; ack(true)\npair dispatch(w=1) =&gt; ack(true)\npair deliver(w=1) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=1) =&gt; ack(true)\npair reserve(w=2, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=2) =&gt; ack(true)\npair dispatch(w=2) =&gt; ack(true)\npair deliver(w=2) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=2) =&gt; ack(true)\npair reserve(w=3, q=q, label=\"BOX\") =&gt; ack(true)\npair pack(w=3) =&gt; ack(true)\npair dispatch(w=3) =&gt; ack(true)\npair deliver(w=3) =&gt; receipt(q), parcelOut((\"BOX\", q))\npair settle(w=3) =&gt; ack(true)","maxDepth":4}}],"satelExample":{"id":"scale-fulfilment-128-8-4-stock-leak","role":"mutant","name":"Regional fulfilment","description":"Independent regional stock, wallet, permit and resource policies; continuous reserve/pack/dispatch/deliver/settle lifecycle."}}</apn:satel></net></pnml>