rceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>ph</apn:text></apn:binding></arc><arc id="allocate-in-plan-1" source="plan" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="allocate-in-available_0-2" source="available_0" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s0</apn:text></apn:binding></arc><arc id="allocate-in-available_1-3" source="available_1" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s1</apn:text></apn:binding></arc><arc id="allocate-in-available_2-4" source="available_2" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s2</apn:text></apn:binding></arc><arc id="allocate-in-available_3-5" source="available_3" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s3</apn:text></apn:binding></arc><arc id="allocate-in-available_4-6" source="available_4" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s4</apn:text></apn:binding></arc><arc id="allocate-in-available_5-7" source="available_5" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s5</apn:text></apn:binding></arc><arc id="allocate-in-available_6-8" source="available_6" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s6</apn:text></apn:binding></arc><arc id="allocate-in-available_7-9" source="available_7" target="allocate"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s7</apn:text></apn:binding></arc><arc id="allocate-out-phase-0" source="allocate" target="phase"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>1</apn:text></apn:binding></arc><arc id="allocate-out-plan-1" source="allocate" target="plan"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>[q0, q1, q2, q3, q4, q5, q6, q7]</apn:text></apn:binding></arc><arc id="allocate-out-ack-2" source="allocate" target="ack"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>true</apn:text></apn:binding></arc><arc id="allocate-out-available_0-3" source="allocate" target="available_0"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s0 - q0</apn:text></apn:binding></arc><arc id="allocate-out-available_1-4" source="allocate" target="available_1"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s1 - q1</apn:text></apn:binding></arc><arc id="allocate-out-available_2-5" source="allocate" target="available_2"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s2 - q2</apn:text></apn:binding></arc><arc id="allocate-out-available_3-6" source="allocate" target="available_3"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s3 - q3</apn:text></apn:binding></arc><arc id="allocate-out-available_4-7" source="allocate" target="available_4"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s4 - q4</apn:text></apn:binding></arc><arc id="allocate-out-available_5-8" source="allocate" target="available_5"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s5 - q5</apn:text></apn:binding></arc><arc id="allocate-out-available_6-9" source="allocate" target="available_6"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s6 - q6</apn:text></apn:binding></arc><arc id="allocate-out-available_7-10" source="allocate" target="available_7"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s7 - q7</apn:text></apn:binding></arc><arc id="confirm-in-phase-0" source="phase" target="confirm"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>ph</apn:text></apn:binding></arc><arc id="confirm-in-plan-1" source="plan" target="confirm"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="confirm-out-phase-0" source="confirm" target="phase"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>0</apn:text></apn:binding></arc><arc id="confirm-out-plan-1" source="confirm" target="plan"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>[]</apn:text></apn:binding></arc><arc id="confirm-out-allocation-2" source="confirm" target="allocation"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>tail(xs)</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="1">{"places":[{"id":"phase","sort":"Int","io_type":"internal"},{"id":"plan","sort":"List","io_type":"internal"},{"id":"ack","sort":"Bool","io_type":"output"},{"id":"allocation","sort":"List","io_type":"output"},{"id":"available_0","sort":"Int","io_type":"internal"},{"id":"available_1","sort":"Int","io_type":"internal"},{"id":"available_2","sort":"Int","io_type":"internal"},{"id":"available_3","sort":"Int","io_type":"internal"},{"id":"available_4","sort":"Int","io_type":"internal"},{"id":"available_5","sort":"Int","io_type":"internal"},{"id":"available_6","sort":"Int","io_type":"internal"},{"id":"available_7","sort":"Int","io_type":"internal"}],"transitions":[{"id":"allocate","method":{"name":"allocate","parameters":[{"name":"q0","sort":"Int"},{"name":"q1","sort":"Int"},{"name":"q2","sort":"Int"},{"name":"q3","sort":"Int"},{"name":"q4","sort":"Int"},{"name":"q5","sort":"Int"},{"name":"q6","sort":"Int"},{"name":"q7","sort":"Int"}]}},{"id":"confirm","method":{"name":"confirm","parameters":[]}}],"testIntentions":[{"id":"exercise-resource-allocation","name":"Coupled allocation of 8 resources","kind":"symbolic","symbolic":{"source":"operation candidate(Int, Int, Int, Int, Int, Int, Int, Int): Bool\nrule candidate.all(q0: Int, q1: Int, q2: Int, q3: Int, q4: Int, q5: Int, q6: Int, q7: Int): candidate(q0, q1, q2, q3, q4, q5, q6, q7) = true","variablesText":"q0: Int, q1: Int, q2: Int, q3: Int, q4: Int, q5: Int, q6: Int, q7: Int","argsText":"q0, q1, q2, q3, q4, q5, q6, q7","operation":"candidate","conditionsText":"","protocolSource":"case run(q0: Int, q1: Int, q2: Int, q3: Int, q4: Int, q5: Int, q6: Int, q7: Int):\ninputs q0, q1, q2, q3, q4, q5, q6, q7\nresult true\npair allocate(q0=q0, q1=q1, q2=q2, q3=q3, q4=q4, q5=q5, q6=q6, q7=q7) =&gt; ack(true)\npair confirm() =&gt; allocation([q0, q1, q2, q3, q4, q5, q6, q7])","maxDepth":2}}],"satelExample":{"id":"scale-allocation-8-wrong-allocation","name":"Coupled resource allocator","role":"mutant","description":"Select a vector of quantities satisfying all stock, neighboring resource and total-budget constraints, then confirm exactly that allocation."}}</apn:satel></net></pnml>