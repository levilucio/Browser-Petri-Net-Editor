<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="phase"><name><text>phase</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>0</apn:text></apn:token></apn:valueTokens></place><place id="plan"><name><text>plan</text></name><graphics><position x="140" y="240"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>[]</apn:text></apn:token></apn:valueTokens></place><place id="ack"><name><text>ack</text></name><graphics><position x="1000" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"/></place><place id="allocation"><name><text>allocation</text></name><graphics><position x="1000" y="240"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"/></place><place id="available_0"><name><text>available_0</text></name><graphics><position x="140" y="380"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>100</apn:text></apn:token></apn:valueTokens></place><place id="available_1"><name><text>available_1</text></name><graphics><position x="140" y="520"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>100</apn:text></apn:token></apn:valueTokens></place><place id="available_2"><name><text>available_2</text></name><graphics><position x="140" y="660"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>100</apn:text></apn:token></apn:valueTokens></place><place id="available_3"><name><text>available_3</text></name><graphics><position x="140" y="800"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>100</apn:text></apn:token></apn:valueTokens></place><place id="available_4"><name><text>available_4</text></