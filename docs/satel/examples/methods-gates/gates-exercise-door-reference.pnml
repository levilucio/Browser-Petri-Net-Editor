<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="settings"><name><text>settings</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>(F, F)</apn:text></apn:token></apn:valueTokens></place><place id="opened"><name><text>opened</text></name><graphics><position x="140" y="240"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>F</apn:text></apn:token></apn:valueTokens></place><transition id="configure"><name><text>configure</text></name><graphics><position x="430" y="130"/></graphics></transition><transition id="attempt"><name><text>attempt</text></name><graphics><position x="690" y="130"/></graphics></transition><transition id="reset"><name><text>reset</text></name><graphics><position x="430" y="330"/></graphics></transition><transition id="inspect"><name><text>inspect</text></name><graphics><position x="690" y="330"/></graphics></transition><arc id="configure-in-settings-0" source="settings" target="configure"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="configure-out-settings-0" source="configure" target="settings"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>(enabled, jammed)</apn:text></apn:binding></arc><arc id="attempt-in-settings-0" source="settings" target="attempt"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="attempt-in-opened-1" source="opened" target="attempt"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="attempt-out-settings-0" source="attempt" target="settings"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="attempt-out-opened-1" source="attempt" target="opened"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>asBool(fst(s)) and not asBool(snd(s))</apn:text></apn:binding></arc><arc id="reset-in-opened-0" source="opened" target="reset"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="reset-out-opened-0" source="reset" target="opened"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>false</apn:text></apn:binding></arc><arc id="inspect-in-opened-0" source="opened" target="inspect"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>v</apn:text></apn:binding></arc><arc id="inspect-out-opened-0" source="inspect" target="opened"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>v</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"settings","sort":"Pair","io_type":"internal"},{"id":"opened","sort":"Bool","io_type":"internal"}],"transitions":[{"id":"configure","method":{"name":"configure","parameters":[{"name":"enabled","sort":"Bool"},{"name":"jammed","sort":"Bool"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"attempt","method":{"name":"attempt","parameters":[]},"gates":[{"gate":"access","arguments":["asBool(fst(s)) and not asBool(snd(s))"]}]},{"id":"reset","method":{"name":"reset","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"inspect","method":{"name":"inspect","parameters":[]},"gates":[{"gate":"doorState","arguments":["v"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"access","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"doorState","parameters":[{"name":"arg1","sort":"Bool"}]}],"apnClass":"exercise_door_reference","testIntentions":[{"id":"exercise-door","name":"Door interlock — permission and obstruction (4 pairs)","kind":"symbolic","symbolic":{"source":"operation permitted(Bool, Bool): Bool\nrule offClear(): permitted(false, false) = false\nrule offJammed(): permitted(false, true) = false\nrule onClear(): permitted(true, false) = true\nrule onJammed(): permitted(true, true) = false","variablesText":"e: Bool, j: Bool","argsText":"e, j","operation":"permitted","conditionsText":"","protocolSource":"case run(e: Bool, j: Bool, allowed: Bool):\ninputs e, j\nresult allowed\npair configure(enabled=e, jammed=j) =&gt; ack(true)\npair attempt() =&gt; access(allowed)\npair reset() =&gt; ack(true)\npair inspect() =&gt; doorState(false)","maxDepth":12},"description":"Four permission/obstruction combinations, followed by reset. 4 algebraic classes; 4 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-door-reference","name":"Methods &amp; gates — Door interlock reference — 4 pairs","role":"reference","description":"Four permission/obstruction combinations, followed by reset."}}</apn:satel></net></pnml>