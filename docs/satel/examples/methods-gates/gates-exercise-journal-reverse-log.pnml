<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="current"><name><text>current</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>0</apn:text></apn:token></apn:valueTokens></place><place id="journal"><name><text>journal</text></name><graphics><position x="140" y="240"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>[]</apn:text></apn:token></apn:valueTokens></place><place id="label"><name><text>label</text></name><graphics><position x="140" y="380"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>"sensor"</apn:text></apn:token></apn:valueTokens></place><transition id="record"><name><text>record</text></name><graphics><position x="430" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>delta &gt;= -2 and delta &lt;= 2 and delta != 0</apn:text></apn:guard></transition><transition id="read"><name><text>read</text></name><graphics><position x="690" y="130"/></graphics></transition><arc id="record-in-current-0" source="current" target="record"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>v</apn:text></apn:binding></arc><arc id="record-in-journal-1" source="journal" target="record"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="record-out-current-0" source="record" target="current"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>v + delta</apn:text></apn:binding></arc><arc id="record-out-journal-1" source="record" target="journal"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>[(v + delta, armed) | xs]</apn:text></apn:binding></arc><arc id="read-in-journal-0" source="journal" target="read"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="read-in-label-1" source="label" target="read"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="read-out-journal-0" source="read" target="journal"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="read-out-label-1" source="read" target="label"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"current","sort":"Int","io_type":"internal"},{"id":"journal","sort":"List","io_type":"internal"},{"id":"label","sort":"String","io_type":"internal"}],"transitions":[{"id":"record","method":{"name":"record","parameters":[{"name":"delta","sort":"Int"},{"name":"armed","sort":"Bool"}]},"gates":[{"gate":"alarm","arguments":["armed and delta &gt; 0"]}]},{"id":"read","method":{"name":"read","parameters":[]},"gates":[{"gate":"records","arguments":["xs"]},{"gate":"source","arguments":["s"]}]}],"gates":[{"name":"alarm","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"records","parameters":[{"name":"arg1","sort":"List"}]},{"name":"source","parameters":[{"name":"arg1","sort":"String"}]}],"apnClass":"exercise_journal_reverse_log","testIntentions":[{"id":"exercise-journal","name":"Sensor journal — ten cumulative readings (20 pairs)","kind":"symbolic","symbolic":{"source":"operation alarmFor(Int, Bool): Bool\nrule fallingQuiet(d: Int): alarmFor(d, false) = false if d &lt; 0\nrule fallingArmed(d: Int): alarmFor(d, true) = false if d &lt; 0\nrule risingQuiet(d: Int): alarmFor(d, false) = false if d &gt; 0\nrule risingArmed(d: Int): alarmFor(d, true) = true if d &gt; 0","variablesText":"d: Int, b: Bool","argsText":"d, b","operation":"alarmFor","conditionsText":"d &gt;= -2 and d &lt;= 2 and d != 0","protocolSource":"case run(d: Int, b: Bool, a: Bool):\ninputs d, b\nresult a\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b), (4 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b), (4 * d, b), (5 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b), (4 * d, b), (5 * d, b), (6 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b), (4 * d, b), (5 * d, b), (6 * d, b), (7 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b), (4 * d, b), (5 * d, b), (6 * d, b), (7 * d, b), (8 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b), (4 * d, b), (5 * d, b), (6 * d, b), (7 * d, b), (8 * d, b), (9 * d, b)]), source(\"sensor\")\npair record(delta=d, armed=b) =&gt; alarm(a)\npair read() =&gt; records([(1 * d, b), (2 * d, b), (3 * d, b), (4 * d, b), (5 * d, b), (6 * d, b), (7 * d, b), (8 * d, b), (9 * d, b), (10 * d, b)]), source(\"sensor\")","maxDepth":12},"description":"Ten record/read rounds; growing lists of cumulative readings and alarm flags. 4 algebraic classes; 20 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-journal-reverse-log","name":"Methods &amp; gates — Sensor journal mutant — Newest record first","role":"mutant","description":"Prepends each new reading instead of appending."}}</apn:satel></net></pnml>