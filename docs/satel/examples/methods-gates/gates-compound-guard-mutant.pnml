<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="ready"><name><text>ready</text></name><graphics><position x="200" y="280"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>1</apn:text></apn:token></apn:valueTokens></place><transition id="accept"><name><text>yes</text></name><graphics><position x="420" y="170"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>x &gt; 0 and x &lt; 5</apn:text></apn:guard></transition><transition id="refuse"><name><text>no</text></name><graphics><position x="420" y="390"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>not (x &gt; 0 and x &lt; 5)</apn:text></apn:guard></transition><arc id="ready-accept" source="ready" target="accept"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r</apn:text></apn:binding></arc><arc id="accept-ready" source="accept" target="ready"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r</apn:text></apn:binding></arc><arc id="ready-refuse" source="ready" target="refuse"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r</apn:text></apn:binding></arc><arc id="refuse-ready" source="refuse" target="ready"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"ready","sort":"Int","io_type":"internal"}],"transitions":[{"id":"accept","method":{"name":"check","parameters":[{"name":"x","sort":"Int"}]},"gates":[{"gate":"accepted","arguments":["1"]}]},{"id":"refuse","method":{"name":"check","parameters":[{"name":"x","sort":"Int"}]},"gates":[{"gate":"accepted","arguments":["0"]}]}],"gates":[{"name":"accepted","parameters":[{"name":"arg1","sort":"Int"}]}],"apnClass":"compound_guard_mutant","testIntentions":[{"id":"compound-guard","name":"Shared x — compound guard classes","kind":"symbolic","description":"One variable shared across three guard terms; disjoint true/false regions before oracle execution.","symbolic":{"source":"","goalKind":"guard","guardText":"x &gt; 0 and (x &lt; 5 or x == 10)","variablesText":"x: Int","maxDepth":4,"protocolSource":"case accepted(x: Int):\ninputs x\nresult true\npair check(x=x) =&gt; accepted(1)\ncase refused(x: Int):\ninputs x\nresult false\npair check(x=x) =&gt; accepted(0)"}}],"satelExample":{"id":"gates-compound-guard-mutant","name":"Methods &amp; gates — Compound guard — missing x = 10 mutant","role":"mutant","description":"check(x) preserves the initial ready token and emits 1 or 0. A single x determines every guard term."}}</apn:satel></net></pnml>