Class hml_adt_pair_reference;

Interface
  Methods
    open : Pair;
    finish : ;
  Gates
    ack : Bool;
    item : Pair;

Body
  Places
    state : Int;
    value : Pair;
  Initial
    state (0), value ((0, false));
  Axioms
    openA: open x With this.ack (true) ::
      s == 0 => state s, value old -> state (1), value (x);
    openB: open x With this.ack (true) ::
      s == 0 => state s, value old -> state (2), value (x);
    finish: finish With this.ack (true) // this.item (v) ::
      s == 1 or (s == 2 and (asInt(fst(v)) >= 3 and asBool(snd(v)))) => state s, value v -> state (3), value (v);

End hml_adt_pair_reference;
