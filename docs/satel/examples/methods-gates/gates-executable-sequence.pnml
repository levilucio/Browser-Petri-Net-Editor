<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="balance"><name><text>balance</text></name><graphics><position x="420" y="300"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>10</apn:text></apn:token></apn:valueTokens></place><transition id="deposit"><name><text>deposit(n)</text></name><graphics><position x="180" y="100"/></graphics></transition><transition id="withdrawAccepted"><name><text>withdraw(n): pay</text></name><graphics><position x="180" y="240"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &lt;= b</apn:text></apn:guard></transition><transition id="withdrawRefused"><name><text>withdraw(n): refuse</text></name><graphics><position x="180" y="360"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &gt; b</apn:text></apn:guard></transition><transition id="withdrawAll"><name><text>withdrawAll()</text></name><graphics><position x="180" y="480"/></graphics></transition><transition id="query"><name><text>query()</text></name><graphics><position x="480" y="540"/></graphics></transition><arc id="balance-deposit" source="balance" target="deposit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="deposit-balance" source="deposit" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b + n</apn:text></apn:binding></arc><arc id="balance-withdrawAccepted" source="balance" target="withdrawAccepted"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="withdrawAccepted-balance" source="withdrawAccepted" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b - n</apn:text></apn:binding></arc><arc id="balance-withdrawRefused" source="balance" target="withdrawRefused"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="withdrawRefused-balance" source="withdrawRefused" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="balance-withdrawAll" source="balance" target="withdrawAll"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="withdrawAll-balance" source="withdrawAll" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>0</apn:text></apn:binding></arc><arc id="balance-query" source="balance" target="query"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="query-balance" source="query" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"balance","sort":"Nat","io_type":"internal"}],"transitions":[{"id":"deposit","method":{"name":"deposit","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["1"]}]},{"id":"withdrawAccepted","method":{"name":"withdraw","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["1"]},{"gate":"paidAmount","arguments":["n"]}]},{"id":"withdrawRefused","method":{"name":"withdraw","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["0"]}]},{"id":"withdrawAll","method":{"name":"withdrawAll","parameters":[]},"gates":[{"gate":"ack","arguments":["1"]},{"gate":"paidAmount","arguments":["b"]}]},{"id":"query","method":{"name":"query","parameters":[]},"gates":[{"gate":"balanceResult","arguments":["b"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"paidAmount","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"balanceResult","parameters":[{"name":"arg1","sort":"Nat"}]}],"apnClass":"executable_sequence","testIntentions":[{"id":"executable-sequence","kind":"symbolic","name":"Withdraw twice — choose the first amount from the whole sequence","description":"The zero class withdraws 0 then 10. The positive class must choose 3 before withdrawing 7, so the final balance is zero. A static representative of 1 cannot satisfy that sequence.","symbolic":{"source":"operation isZero(Nat): Bool\nrule zero(n: Nat): isZero(n) = true if n == 0\nrule positive(n: Nat): isZero(n) = false if n &gt; 0","operation":"isZero","argsText":"n","variablesText":"n: Nat","conditionsText":"n &lt;= 10","maxDepth":2,"protocolSource":"case zero(n: Nat):\ninputs n\nresult true\npair withdraw(n=n) =&gt; ack(1), paidAmount(n)\npair withdraw(n=10) =&gt; ack(1), paidAmount(10)\npair query() =&gt; balanceResult(0)\n\ncase positive(n: Nat):\ninputs n\nresult false\npair withdraw(n=n) =&gt; ack(1), paidAmount(n)\npair withdraw(n=7) =&gt; ack(1), paidAmount(7)\npair query() =&gt; balanceResult(0)"}}],"satelExample":{"id":"gates-executable-sequence","name":"Methods &amp; gates — Whole-sequence selection — Reference","role":"reference","description":"Initial balance 10. The final zero balance constrains the first withdrawal. Generate on the reference, then replay the frozen suite on the mutant."}}</apn:satel></net></pnml>