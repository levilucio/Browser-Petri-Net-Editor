<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="storage"><name><text>storage</text></name><graphics><position x="220" y="300"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>[]</apn:text></apn:token></apn:valueTokens></place><transition id="accept"><name><text>yes</text></name><graphics><position x="430" y="180"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>enabled and length(items) &gt; 0 and length(label) &gt; 0 and fst(meta) == label</apn:text></apn:guard></transition><transition id="refuse"><name><text>no</text></name><graphics><position x="430" y="340"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>not (enabled and length(items) &gt; 0 and length(label) &gt; 0 and fst(meta) == label)</apn:text></apn:guard></transition><transition id="read"><name><text>read</text></name><graphics><position x="430" y="520"/></graphics></transition><arc id="storage-accept" source="storage" target="accept"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="accept-storage" source="accept" target="storage"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>tail(items)</apn:text></apn:binding></arc><arc id="storage-refuse" source="storage" target="refuse"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="refuse-storage" source="refuse" target="storage"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="storage-read" source="storage" target="read"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="read-storage" source="read" target="storage"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"storage","sort":"List","io_type":"internal"}],"transitions":[{"id":"accept","method":{"name":"store","parameters":[{"name":"items","sort":"List"},{"name":"label","sort":"String"},{"name":"enabled","sort":"Bool"},{"name":"meta","sort":"Pair"}]},"gates":[{"gate":"ack","arguments":["true"]},{"gate":"echoed","arguments":["items"]},{"gate":"labelOut","arguments":["label"]},{"gate":"metaOut","arguments":["meta"]}]},{"id":"refuse","method":{"name":"store","parameters":[{"name":"items","sort":"List"},{"name":"label","sort":"String"},{"name":"enabled","sort":"Bool"},{"name":"meta","sort":"Pair"}]},"gates":[{"gate":"ack","arguments":["false"]}]},{"id":"read","method":{"name":"read","parameters":[]},"gates":[{"gate":"saved","arguments":["old"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"echoed","parameters":[{"name":"arg1","sort":"List"}]},{"name":"labelOut","parameters":[{"name":"arg1","sort":"String"}]},{"name":"metaOut","parameters":[{"name":"arg1","sort":"Pair"}]},{"name":"saved","parameters":[{"name":"arg1","sort":"List"}]}],"apnClass":"typed_store_mutant","testIntentions":[{"id":"typed-store","name":"Typed store — constructor and guard classes","kind":"symbolic","symbolic":{"source":"operation accepted(List, String, Bool, Pair): Bool\nrule disabled(xs: List, s: String, p: Pair): accepted(xs, s, false, p) = false\nrule empty(s: String, p: Pair): accepted([], s, true, p) = false\nrule accepted(h: Any, t: List, s: String, p: Pair): accepted([h | t], s, true, p) = true if length(s) &gt; 0 and fst(p) == s\nrule refused(h: Any, t: List, s: String, p: Pair): accepted([h | t], s, true, p) = false if not (length(s) &gt; 0 and fst(p) == s)","operation":"accepted","argsText":"items, label, enabled, (tag, false)","variablesText":"items: List, label: String, enabled: Bool, tag: String","maxDepth":8,"protocolSource":"case accepted(xs: List, s: String, p: Pair):\ninputs xs, s, true, p\nresult true\npair store(items=xs, label=s, enabled=true, meta=p) =&gt; ack(true), echoed(xs), labelOut(s), metaOut(p)\npair read() =&gt; saved(xs)\ncase refused(xs: List, s: String, b: Bool, p: Pair):\ninputs xs, s, b, p\nresult false\npair store(items=xs, label=s, enabled=b, meta=p) =&gt; ack(false)\npair read() =&gt; saved([])"}}],"satelExample":{"id":"gates-typed-store-mutant","name":"Methods &amp; gates — Typed store — drops first item mutant","role":"mutant","description":"store(List, String, Bool, Pair) accepts a nonempty list when enabled and the nonempty label matches the first metadata field. read() observes stored contents. Initial storage contains one empty-list token."}}</apn:satel></net></pnml>