<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="remaining"><name><text>remaining</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>0</apn:text></apn:token></apn:valueTokens></place><transition id="issue"><name><text>issue</text></name><graphics><position x="430" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &gt;= 2 and n &lt;= 4</apn:text></apn:guard></transition><transition id="use"><name><text>use</text></name><graphics><position x="690" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &gt; 0</apn:text></apn:guard></transition><transition id="inspect"><name><text>inspect</text></name><graphics><position x="430" y="330"/></graphics></transition><transition id="finish"><name><text>finish</text></name><graphics><position x="690" y="330"/></graphics></transition><arc id="issue-in-remaining-0" source="remaining" target="issue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="issue-out-remaining-0" source="issue" target="remaining"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>n</apn:text></apn:binding></arc><arc id="use-in-remaining-0" source="remaining" target="use"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>n</apn:text></apn:binding></arc><arc id="use-out-remaining-0" source="use" target="remaining"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>n - 1</apn:text></apn:binding></arc><arc id="inspect-in-remaining-0" source="remaining" target="inspect"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>n</apn:text></apn:binding></arc><arc id="inspect-out-remaining-0" source="inspect" target="remaining"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>n</apn:text></apn:binding></arc><arc id="finish-in-remaining-0" source="remaining" target="finish"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>n</apn:text></apn:binding></arc><arc id="finish-out-remaining-0" source="finish" target="remaining"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>0</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"remaining","sort":"Nat","io_type":"internal"}],"transitions":[{"id":"issue","method":{"name":"issue","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"use","method":{"name":"use","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"inspect","method":{"name":"inspect","parameters":[]},"gates":[{"gate":"count","arguments":["n"]}]},{"id":"finish","method":{"name":"finish","parameters":[]},"gates":[{"gate":"count","arguments":["n"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"count","parameters":[{"name":"arg1","sort":"Nat"}]}],"apnClass":"exercise_tickets_reference","testIntentions":[{"id":"exercise-tickets","name":"Ticket booklet — two uses and settlement (6 pairs)","kind":"symbolic","symbolic":{"source":"operation afterTwo(Nat): Nat\nrule exhausted(): afterTwo(2) = 0\nrule spare(n: Nat): afterTwo(n) = n - 2 if n &gt; 2","variablesText":"n: Nat","argsText":"n","operation":"afterTwo","conditionsText":"n &gt;= 2 and n &lt;= 4","protocolSource":"case run(n: Nat, left: Nat):\ninputs n\nresult left\npair issue(n=n) =&gt; ack(true)\npair use() =&gt; ack(true)\npair inspect() =&gt; count(n - 1)\npair use() =&gt; ack(true)\npair inspect() =&gt; count(left)\npair finish() =&gt; count(left)","maxDepth":12},"description":"Two uses distinguish exhaustion from remaining tickets. 2 algebraic classes; 6 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-tickets-reference","name":"Methods &amp; gates — Ticket booklet reference — 6 pairs","role":"reference","description":"Two uses distinguish exhaustion from remaining tickets."}}</apn:satel></net></pnml>