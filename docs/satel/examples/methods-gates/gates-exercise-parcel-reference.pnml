s":[{"gate":"ack","arguments":["true"]}]},{"id":"returnToSender","method":{"name":"returnToSender","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"reset","method":{"name":"reset","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"read","method":{"name":"read","parameters":[]},"gates":[{"gate":"metadata","arguments":["p"]},{"gate":"stage","arguments":["s"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"metadata","parameters":[{"name":"arg1","sort":"Pair"}]},{"name":"stage","parameters":[{"name":"arg1","sort":"Nat"}]}],"apnClass":"exercise_parcel_reference","testIntentions":[{"id":"exercise-parcel","name":"Parcel — label, handling flag and lifecycle (14 pairs)","kind":"symbolic","symbolic":{"source":"operation handling(Pair): Nat\nrule emptyRegular(): handling((\"\", false)) = 0\nrule emptyFragile(): handling((\"\", true)) = 1\nrule namedRegular(s: String): handling((s, false)) = 2 if length(s) &gt; 0\nrule namedFragile(s: String): handling((s, true)) = 3 if length(s) &gt; 0","variablesText":"s: String, fragile: Bool","argsText":"(s, fragile)","operation":"handling","conditionsText":"length(s) &lt;= 4 and isSubstringOf(s, \"BOX1\")","protocolSource":"case run(s: String, fragile: Bool, kind: Nat):\ninputs (s, fragile)\nresult kind\npair create(meta=(s, fragile)) =&gt; ack(true)\npair read() =&gt; metadata((s, fragile)), stage(1)\npair relabel() =&gt; ack(true)\npair read() =&gt; metadata((concat(\"ID:\", s), fragile)), stage(2)\npair markFragile() =&gt; ack(true)\npair read() =&gt; metadata((concat(\"ID:\", s), true)), stage(3)\npair dispatch() =&gt; ack(true)\npair read() =&gt; metadata((concat(\"ID:\", s), true)), stage(4)\npair deliver() =&gt; ack(true)\npair read() =&gt; metadata((concat(\"ID:\", s), true)), stage(5)\npair returnToSender() =&gt; ack(true)\npair read() =&gt; metadata((concat(concat(\"ID:\", s), \":RETURN\"), true)), stage(6)\npair reset() =&gt; ack(true)\npair read() =&gt; metadata((\"\", false)), stage(0)","maxDepth":12},"description":"Empty/named × regular/fragile metadata through seven lifecycle stages. 4 algebraic classes; 14 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-parcel-reference","name":"Methods &amp; gates — Parcel lifecycle reference — 14 pairs","role":"reference","description":"Empty/named × regular/fragile metadata through seven lifecycle stages."}}</apn:satel></net></pnml>