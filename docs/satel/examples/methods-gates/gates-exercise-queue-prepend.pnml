<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="queue"><name><text>queue</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>[]</apn:text></apn:token></apn:valueTokens></place><transition id="load"><name><text>load</text></name><graphics><position x="430" y="130"/></graphics></transition><transition id="enqueue"><name><text>enqueue</text></name><graphics><position x="690" y="130"/></graphics></transition><transition id="read"><name><text>read</text></name><graphics><position x="430" y="330"/></graphics></transition><transition id="dequeue"><name><text>dequeue</text></name><graphics><position x="690" y="330"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>length(xs) &gt; 0</apn:text></apn:guard></transition><transition id="clear"><name><text>clear</text></name><graphics><position x="430" y="530"/></graphics></transition><arc id="load-in-queue-0" source="queue" target="load"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="load-out-queue-0" source="load" target="queue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="enqueue-in-queue-0" source="queue" target="enqueue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="enqueue-out-queue-0" source="enqueue" target="queue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>[n | xs]</apn:text></apn:binding></arc><arc id="read-in-queue-0" source="queue" target="read"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="read-out-queue-0" source="read" target="queue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="dequeue-in-queue-0" source="queue" target="dequeue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="dequeue-out-queue-0" source="dequeue" target="queue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>tail(xs)</apn:text></apn:binding></arc><arc id="clear-in-queue-0" source="queue" target="clear"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>xs</apn:text></apn:binding></arc><arc id="clear-out-queue-0" source="clear" target="queue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>[]</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"queue","sort":"List","io_type":"internal"}],"transitions":[{"id":"load","method":{"name":"load","parameters":[{"name":"xs","sort":"List"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"enqueue","method":{"name":"enqueue","parameters":[{"name":"n","sort":"Int"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"read","method":{"name":"read","parameters":[]},"gates":[{"gate":"items","arguments":["xs"]}]},{"id":"dequeue","method":{"name":"dequeue","parameters":[]},"gates":[{"gate":"removed","arguments":["asInt(head(xs))"]}]},{"id":"clear","method":{"name":"clear","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"items","parameters":[{"name":"arg1","sort":"List"}]},{"name":"removed","parameters":[{"name":"arg1","sort":"Int"}]}],"apnClass":"exercise_queue_prepend","testIntentions":[{"id":"exercise-queue","name":"FIFO queue — bounded constructor seeds (12 pairs)","kind":"symbolic","symbolic":{"source":"operation seedShape(List): Nat\nrule empty(): seedShape([]) = 0\nrule single(a: Int): seedShape([a]) = 1\nrule double(a: Int, b: Int): seedShape([a, b]) = 2","variablesText":"xs: List","argsText":"xs","operation":"seedShape","conditionsText":"","protocolSource":"case run(xs: List, size: Nat):\ninputs xs\nresult size\npair load(xs=xs) =&gt; ack(true)\npair enqueue(n=7) =&gt; ack(true)\npair enqueue(n=8) =&gt; ack(true)\npair read() =&gt; items(concat(xs, [7, 8]))\npair dequeue() =&gt; removed(asInt(head(concat(xs, [7, 8]))))\npair read() =&gt; items(tail(concat(xs, [7, 8])))\npair enqueue(n=9) =&gt; ack(true)\npair read() =&gt; items(append(tail(concat(xs, [7, 8])), 9))\npair dequeue() =&gt; removed(asInt(head(append(tail(concat(xs, [7, 8])), 9))))\npair read() =&gt; items(tail(append(tail(concat(xs, [7, 8])), 9)))\npair clear() =&gt; ack(true)\npair read() =&gt; items([])","maxDepth":12},"description":"Empty, one-item and two-item integer seeds; enqueue and dequeue. 3 algebraic classes; 12 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-queue-prepend","name":"Methods &amp; gates — FIFO queue mutant — Enqueues at the front","role":"mutant","description":"Insertion uses prepend instead of append."}}</apn:satel></net></pnml>