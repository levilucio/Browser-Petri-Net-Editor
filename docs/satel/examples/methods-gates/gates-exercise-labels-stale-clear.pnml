<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="label"><name><text>label</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>""</apn:text></apn:token></apn:valueTokens></place><transition id="register"><name><text>register</text></name><graphics><position x="430" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>length(s) &lt;= 6</apn:text></apn:guard></transition><transition id="read"><name><text>read</text></name><graphics><position x="690" y="130"/></graphics></transition><transition id="prefix"><name><text>prefix</text></name><graphics><position x="430" y="330"/></graphics></transition><transition id="suffix"><name><text>suffix</text></name><graphics><position x="690" y="330"/></graphics></transition><transition id="clear"><name><text>clear</text></name><graphics><position x="430" y="530"/></graphics></transition><arc id="register-in-label-0" source="label" target="register"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="register-out-label-0" source="register" target="label"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="read-in-label-0" source="label" target="read"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="read-out-label-0" source="read" target="label"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="prefix-in-label-0" source="label" target="prefix"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="prefix-out-label-0" source="prefix" target="label"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>concat("#", s)</apn:text></apn:binding></arc><arc id="suffix-in-label-0" source="label" target="suffix"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="suffix-out-label-0" source="suffix" target="label"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>concat(s, "!")</apn:text></apn:binding></arc><arc id="clear-in-label-0" source="label" target="clear"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="clear-out-label-0" source="clear" target="label"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"label","sort":"String","io_type":"internal"}],"transitions":[{"id":"register","method":{"name":"register","parameters":[{"name":"s","sort":"String"}]},"gates":[{"gate":"accepted","arguments":["length(s) &gt; 0 and length(s) &lt;= 3"]}]},{"id":"read","method":{"name":"read","parameters":[]},"gates":[{"gate":"text","arguments":["s"]}]},{"id":"prefix","method":{"name":"prefix","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"suffix","method":{"name":"suffix","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"clear","method":{"name":"clear","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]}],"gates":[{"name":"accepted","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"text","parameters":[{"name":"arg1","sort":"String"}]},{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]}],"apnClass":"exercise_labels_stale_clear","testIntentions":[{"id":"exercise-labels","name":"Label editor — empty, short and long text (8 pairs)","kind":"symbolic","symbolic":{"source":"operation shortLabel(String): Bool\nrule empty(s: String): shortLabel(s) = false if length(s) == 0\nrule short(s: String): shortLabel(s) = true if length(s) &gt; 0 and length(s) &lt;= 3\nrule long(s: String): shortLabel(s) = false if length(s) &gt; 3","variablesText":"s: String","argsText":"s","operation":"shortLabel","conditionsText":"length(s) &lt;= 6 and isSubstringOf(s, \"ABCDEF\")","protocolSource":"case run(s: String, ok: Bool):\ninputs s\nresult ok\npair register(s=s) =&gt; accepted(ok)\npair read() =&gt; text(s)\npair prefix() =&gt; ack(true)\npair read() =&gt; text(concat(\"#\", s))\npair suffix() =&gt; ack(true)\npair read() =&gt; text(concat(concat(\"#\", s), \"!\"))\npair clear() =&gt; ack(true)\npair read() =&gt; text(\"\")","maxDepth":12},"description":"Empty, short and long labels; prefix, suffix, and clear. 3 algebraic classes; 8 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-labels-stale-clear","name":"Methods &amp; gates — Label editor mutant — Clear keeps text","role":"mutant","description":"Clearing leaves the decorated label behind."}}</apn:satel></net></pnml>