rc><arc id="escrow-returnItems-3" source="escrow" target="returnItems"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>held</apn:text></apn:binding></arc><arc id="returns-returnItems-4" source="returns" target="returnItems"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r</apn:text></apn:binding></arc><arc id="returnItems-returned" source="returnItems" target="returned"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>q - quantity</apn:text></apn:binding></arc><arc id="returnItems-returnedQuantity" source="returnItems" target="returnedQuantity"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>quantity</apn:text></apn:binding></arc><arc id="returnItems-stock" source="returnItems" target="stock"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s + quantity</apn:text></apn:binding></arc><arc id="returnItems-wallet" source="returnItems" target="wallet"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>cash + 10 * quantity</apn:text></apn:binding></arc><arc id="returnItems-escrow" source="returnItems" target="escrow"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>held - 10 * quantity</apn:text></apn:binding></arc><arc id="returnItems-returns" source="returnItems" target="returns"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r + 1</apn:text></apn:binding></arc><arc id="delivered-returnRefused-0" source="delivered" target="returnRefused"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>q</apn:text></apn:binding></arc><arc id="returnRefused-delivered" source="returnRefused" target="delivered"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>q</apn:text></apn:binding></arc><arc id="returned-close-0" source="returned" target="close"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>q</apn:text></apn:binding></arc><arc id="returnedQuantity-close-1" source="returnedQuantity" target="close"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>returned</apn:text></apn:binding></arc><arc id="escrow-close-2" source="escrow" target="close"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>held</apn:text></apn:binding></arc><arc id="revenue-close-3" source="revenue" target="close"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>rev</apn:text></apn:binding></arc><arc id="points-close-4" source="points" target="close"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="close-idle" source="close" target="idle"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>1</apn:text></apn:binding></arc><arc id="close-revenue" source="close" target="revenue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>rev + held</apn:text></apn:binding></arc><arc id="close-points" source="close" target="points"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p + q</apn:text></apn:binding></arc><arc id="idle-audit-0" source="idle" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>ready</apn:text></apn:binding></arc><arc id="stock-audit-1" source="stock" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="wallet-audit-2" source="wallet" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>cash</apn:text></apn:binding></arc><arc id="revenue-audit-3" source="revenue" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>rev</apn:text></apn:binding></arc><arc id="points-audit-4" source="points" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="shipments-audit-5" source="shipments" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>sent</apn:text></apn:binding></arc><arc id="returns-audit-6" source="returns" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r</apn:text></apn:binding></arc><arc id="audit-idle" source="audit" target="idle"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>ready</apn:text></apn:binding></arc><arc id="audit-stock" source="audit" target="stock"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>s</apn:text></apn:binding></arc><arc id="audit-wallet" source="audit" target="wallet"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>cash</apn:text></apn:binding></arc><arc id="audit-revenue" source="audit" target="revenue"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>rev</apn:text></apn:binding></arc><arc id="audit-points" source="audit" target="points"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="audit-shipments" source="audit" target="shipments"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>sent</apn:text></apn:binding></arc><arc id="audit-returns" source="audit" target="returns"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>r</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"idle","sort":"Nat","io_type":"internal"},{"id":"draft","sort":"Nat","io_type":"internal"},{"id":"cart","sort":"Nat","io_type":"internal"},{"id":"reserved","sort":"Nat","io_type":"internal"},{"id":"paid","sort":"Nat","io_type":"internal"},{"id":"packed","sort":"Nat","io_type":"internal"},{"id":"transit","sort":"Nat","io_type":"internal"},{"id":"delivered","sort":"Nat","io_type":"internal"},{"id":"returned","sort":"Nat","io_type":"internal"},{"id":"stock","sort":"Nat","io_type":"internal"},{"id":"wallet","sort":"Nat","io_type":"internal"},{"id":"revenue","sort":"Nat","io_type":"internal"},{"id":"points","sort":"Nat","io_type":"internal"},{"id":"shipments","sort":"Nat","io_type":"internal"},{"id":"returns","sort":"Nat","io_type":"internal"},{"id":"crates","sort":"Nat","io_type":"internal"},{"id":"crateLoan","sort":"Nat","io_type":"internal"},{"id":"deliveryMode","sort":"Bool","io_type":"internal"},{"id":"escrow","sort":"Nat","io_type":"internal"},{"id":"returnedQuantity","sort":"Nat","io_type":"internal"}],"transitions":[{"id":"open","method":{"name":"open","parameters":[{"name":"rush","sort":"Bool"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"add","method":{"name":"add","parameters":[{"name":"quantity","sort":"Nat"}]},"gates":[{"gate":"cartAmount","arguments":["quantity"]}]},{"id":"addRefused","method":{"name":"add","parameters":[{"name":"quantity","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["false"]}]},{"id":"reserve","method":{"name":"reserve","parameters":[]},"gates":[{"gate":"reservedAmount","arguments":["q"]}]},{"id":"reserveRefused","method":{"name":"reserve","parameters":[]},"gates":[{"gate":"ack","arguments":["false"]}]},{"id":"pay","method":{"name":"pay","parameters":[]},"gates":[{"gate":"charged","arguments":["10 * q"]}]},{"id":"payRefused","method":{"name":"pay","parameters":[]},"gates":[{"gate":"ack","arguments":["false"]}]},{"id":"pack","method":{"name":"pack","parameters":[]},"gates":[{"gate":"packedAmount","arguments":["q"]}]},{"id":"shipStandardSmall","method":{"name":"ship","parameters":[]},"gates":[{"gate":"shippingFee","arguments":["2"]}]},{"id":"shipStandardBulk","method":{"name":"ship","parameters":[]},"gates":[{"gate":"shippingFee","arguments":["0"]}]},{"id":"shipExpressSmall","method":{"name":"ship","parameters":[]},"gates":[{"gate":"shippingFee","arguments":["5"]}]},{"id":"shipExpressBulk","method":{"name":"ship","parameters":[]},"gates":[{"gate":"shippingFee","arguments":["5"]}]},{"id":"deliver","method":{"name":"deliver","parameters":[]},"gates":[{"gate":"deliveredAmount","arguments":["q"]}]},{"id":"returnItems","method":{"name":"returnItems","parameters":[{"name":"quantity","sort":"Nat"}]},"gates":[{"gate":"refunded","arguments":["10 * quantity"]}]},{"id":"returnRefused","method":{"name":"returnItems","parameters":[{"name":"quantity","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["false"]}]},{"id":"close","method":{"name":"close","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"audit","method":{"name":"audit","parameters":[]},"gates":[{"gate":"stockLevel","arguments":["s"]},{"gate":"walletBalance","arguments":["cash"]},{"gate":"netRevenue","arguments":["rev"]},{"gate":"loyalty","arguments":["p"]},{"gate":"shipmentCount","arguments":["sent"]},{"gate":"returnCount","arguments":["r"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"cartAmount","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"reservedAmount","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"charged","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"packedAmount","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"shippingFee","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"deliveredAmount","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"refunded","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"stockLevel","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"walletBalance","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"netRevenue","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"loyalty","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"shipmentCount","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"returnCount","parameters":[{"name":"arg1","sort":"Nat"}]}],"apnClass":"fulfilment_express_bulk_fee","testIntentions":[{"id":"fulfilment-ten-pairs","kind":"symbolic","name":"Fulfilment — purchase, delivery, partial return and audit (10 pairs)","description":"Four constructor/equation classes. Initial stock 12 and final stock 10 force q − r = 2 across the complete lifecycle. Each admitted test has exactly ten calls.","symbolic":{"source":"constructor Standard(): Delivery\nconstructor Express(): Delivery\nconstructor Receipt(Nat, Nat): Settlement\noperation settle(Nat, Delivery, Nat): Settlement\nrule standard.small(q: Nat, r: Nat): settle(q, Standard(), r) = Receipt(2, 100 - 10 * q - 2 + 10 * r) if q &lt; 4\nrule standard.bulk(q: Nat, r: Nat): settle(q, Standard(), r) = Receipt(0, 100 - 10 * q + 10 * r) if q &gt;= 4\nrule express.small(q: Nat, r: Nat): settle(q, Express(), r) = Receipt(5, 100 - 10 * q - 5 + 10 * r) if q &lt; 4\nrule express.bulk(q: Nat, r: Nat): settle(q, Express(), r) = Receipt(3, 100 - 10 * q - 3 + 10 * r) if q &gt;= 4","operation":"settle","argsText":"q, delivery, r","variablesText":"q: Nat, delivery: Delivery, r: Nat","conditionsText":"q &gt;= 2 and q &lt;= 8 and r &gt; 0 and r &lt; q","maxDepth":2,"protocolSource":"case standard(q: Nat, r: Nat, fee: Nat, cash: Nat):\ninputs q, Standard(), r\nresult Receipt(fee, cash)\npair open(rush=false) =&gt; ack(true)\npair add(quantity=q) =&gt; cartAmount(q)\npair reserve() =&gt; reservedAmount(q)\npair pay() =&gt; charged(10 * q)\npair pack() =&gt; packedAmount(q)\npair ship() =&gt; shippingFee(fee)\npair deliver() =&gt; deliveredAmount(q)\npair returnItems(quantity=r) =&gt; refunded(10 * r)\npair close() =&gt; ack(true)\npair audit() =&gt; stockLevel(10), walletBalance(cash), netRevenue(20 + fee), loyalty(2), shipmentCount(1), returnCount(1)\n\ncase express(q: Nat, r: Nat, fee: Nat, cash: Nat):\ninputs q, Express(), r\nresult Receipt(fee, cash)\npair open(rush=true) =&gt; ack(true)\npair add(quantity=q) =&gt; cartAmount(q)\npair reserve() =&gt; reservedAmount(q)\npair pay() =&gt; charged(10 * q)\npair pack() =&gt; packedAmount(q)\npair ship() =&gt; shippingFee(fee)\npair deliver() =&gt; deliveredAmount(q)\npair returnItems(quantity=r) =&gt; refunded(10 * r)\npair close() =&gt; ack(true)\npair audit() =&gt; stockLevel(10), walletBalance(cash), netRevenue(20 + fee), loyalty(2), shipmentCount(1), returnCount(1)"}}],"satelExample":{"id":"gates-fulfilment-express-bulk-fee","name":"Methods &amp; gates — Fulfilment mutant: Wrong express bulk fee","role":"mutant","description":"Express bulk orders pay 5 instead of the specified 3."}}</apn:satel></net></pnml>