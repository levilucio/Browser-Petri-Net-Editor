<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="temperature"><name><text>temperature</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>20</apn:text></apn:token></apn:valueTokens></place><transition id="cold"><name><text>cold</text></name><graphics><position x="430" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>delta &lt; 0 and delta &gt;= -5 and delta &lt;= 5</apn:text></apn:guard></transition><transition id="steady"><name><text>steady</text></name><graphics><position x="690" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>delta == 0 and delta &gt;= -5 and delta &lt;= 5</apn:text></apn:guard></transition><transition id="warm"><name><text>warm</text></name><graphics><position x="430" y="330"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>delta &gt; 0 and delta &gt;= -5</apn:text></apn:guard></transition><transition id="read"><name><text>read</text></name><graphics><position x="690" y="330"/></graphics></transition><arc id="cold-in-temperature-0" source="temperature" target="cold"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t</apn:text></apn:binding></arc><arc id="cold-out-temperature-0" source="cold" target="temperature"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t + delta</apn:text></apn:binding></arc><arc id="steady-in-temperature-0" source="temperature" target="steady"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t</apn:text></apn:binding></arc><arc id="steady-out-temperature-0" source="steady" target="temperature"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t + delta</apn:text></apn:binding></arc><arc id="warm-in-temperature-0" source="temperature" target="warm"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t</apn:text></apn:binding></arc><arc id="warm-out-temperature-0" source="warm" target="temperature"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t + delta</apn:text></apn:binding></arc><arc id="read-in-temperature-0" source="temperature" target="read"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t</apn:text></apn:binding></arc><arc id="read-out-temperature-0" source="read" target="temperature"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>t</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"temperature","sort":"Int","io_type":"internal"}],"transitions":[{"id":"cold","method":{"name":"adjust","parameters":[{"name":"delta","sort":"Int"}]},"gates":[{"gate":"band","arguments":["-1"]}]},{"id":"steady","method":{"name":"adjust","parameters":[{"name":"delta","sort":"Int"}]},"gates":[{"gate":"band","arguments":["0"]}]},{"id":"warm","method":{"name":"adjust","parameters":[{"name":"delta","sort":"Int"}]},"gates":[{"gate":"band","arguments":["1"]}]},{"id":"read","method":{"name":"read","parameters":[]},"gates":[{"gate":"reading","arguments":["t"]}]}],"gates":[{"name":"band","parameters":[{"name":"arg1","sort":"Int"}]},{"name":"reading","parameters":[{"name":"arg1","sort":"Int"}]}],"apnClass":"refusal_thermostat_mutant","testIntentions":[{"id":"refusal-thermostat","name":"Adjust, read, then refuse an excessive adjustment","kind":"symbolic","symbolic":{"source":"operation direction(Int): Bool\nrule low(d: Int): direction(d) = false if d &lt; 0\nrule high(d: Int): direction(d) = true if d &gt;= 0","operation":"direction","variablesText":"d: Int","argsText":"d","conditionsText":"d &gt;= -6 and d &lt;= 6","maxDepth":2,"protocolSource":"case outside(d: Int, sign: Bool):\ninputs d\nresult sign\npair adjust(delta=1) =&gt; band(1)\npair read() =&gt; reading(21)\npair adjust(delta=d) =&gt; refused"}},{"id":"exercise-thermostat","name":"Thermostat — signed adjustment (2 pairs)","kind":"symbolic","symbolic":{"source":"operation direction(Int): Int\nrule below(d: Int): direction(d) = -1 if d &lt; 0\nrule steady(d: Int): direction(d) = 0 if d == 0\nrule above(d: Int): direction(d) = 1 if d &gt; 0","variablesText":"d: Int","argsText":"d","operation":"direction","conditionsText":"d &gt;= -5 and d &lt;= 5","protocolSource":"case run(d: Int, k: Int):\ninputs d\nresult k\npair adjust(delta=d) =&gt; band(k)\npair read() =&gt; reading(20 + d)","maxDepth":12},"description":"Signed adjustments: below, equal to, and above zero. 3 algebraic classes; 2 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-refusal-thermostat-mutant","name":"Methods &amp; gates — SATEL Refusal — Thermostat mutant: missing upper bound","role":"mutant","description":"The warm rule accepts adjustments larger than five."}}</apn:satel></net></pnml>