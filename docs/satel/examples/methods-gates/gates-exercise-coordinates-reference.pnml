<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="position"><name><text>position</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>(0, 0)</apn:text></apn:token></apn:valueTokens></place><transition id="load"><name><text>load</text></name><graphics><position x="430" y="130"/></graphics></transition><transition id="read"><name><text>read</text></name><graphics><position x="690" y="130"/></graphics></transition><transition id="move"><name><text>move</text></name><graphics><position x="430" y="330"/></graphics></transition><transition id="mirror"><name><text>mirror</text></name><graphics><position x="690" y="330"/></graphics></transition><transition id="reset"><name><text>reset</text></name><graphics><position x="430" y="530"/></graphics></transition><arc id="load-in-position-0" source="position" target="load"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>old</apn:text></apn:binding></arc><arc id="load-out-position-0" source="load" target="position"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="read-in-position-0" source="position" target="read"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="read-out-position-0" source="read" target="position"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="move-in-position-0" source="position" target="move"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="move-out-position-0" source="move" target="position"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>(asInt(fst(p)) + dx, asInt(snd(p)) + dy)</apn:text></apn:binding></arc><arc id="mirror-in-position-0" source="position" target="mirror"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="mirror-out-position-0" source="mirror" target="position"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>(-asInt(fst(p)), -asInt(snd(p)))</apn:text></apn:binding></arc><arc id="reset-in-position-0" source="position" target="reset"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>p</apn:text></apn:binding></arc><arc id="reset-out-position-0" source="reset" target="position"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>(0, 0)</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"position","sort":"Pair","io_type":"internal"}],"transitions":[{"id":"load","method":{"name":"load","parameters":[{"name":"p","sort":"Pair"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"read","method":{"name":"read","parameters":[]},"gates":[{"gate":"point","arguments":["p"]}]},{"id":"move","method":{"name":"move","parameters":[{"name":"dx","sort":"Int"},{"name":"dy","sort":"Int"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"mirror","method":{"name":"mirror","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"reset","method":{"name":"reset","parameters":[]},"gates":[{"gate":"ack","arguments":["true"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"point","parameters":[{"name":"arg1","sort":"Pair"}]}],"apnClass":"exercise_coordinates_reference","testIntentions":[{"id":"exercise-coordinates","name":"Coordinates — translate, mirror and reset (10 pairs)","kind":"symbolic","symbolic":{"source":"operation quadrant(Pair): Nat\nrule southwest(x: Int, y: Int): quadrant((x, y)) = 0 if x &lt; 0 and y &lt; 0\nrule northwest(x: Int, y: Int): quadrant((x, y)) = 1 if x &lt; 0 and y &gt;= 0\nrule southeast(x: Int, y: Int): quadrant((x, y)) = 2 if x &gt;= 0 and y &lt; 0\nrule northeast(x: Int, y: Int): quadrant((x, y)) = 3 if x &gt;= 0 and y &gt;= 0","variablesText":"x: Int, y: Int","argsText":"(x, y)","operation":"quadrant","conditionsText":"x &gt;= -2 and x &lt;= 2 and y &gt;= -2 and y &lt;= 2","protocolSource":"case run(x: Int, y: Int, q: Nat):\ninputs (x, y)\nresult q\npair load(p=(x, y)) =&gt; ack(true)\npair read() =&gt; point((x, y))\npair move(dx=1, dy=0) =&gt; ack(true)\npair read() =&gt; point((x + 1, y))\npair move(dx=0, dy=1) =&gt; ack(true)\npair read() =&gt; point((x + 1, y + 1))\npair mirror() =&gt; ack(true)\npair read() =&gt; point((-(x + 1), -(y + 1)))\npair reset() =&gt; ack(true)\npair read() =&gt; point((0, 0))","maxDepth":12},"description":"Four sign regions; translations, reflection, and reset. 4 algebraic classes; 10 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-coordinates-reference","name":"Methods &amp; gates — Coordinate cursor reference — 10 pairs","role":"reference","description":"Four sign regions; translations, reflection, and reset."}}</apn:satel></net></pnml>