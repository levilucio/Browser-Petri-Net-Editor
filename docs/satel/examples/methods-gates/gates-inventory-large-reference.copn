Class inventory_large_reference;

Interface
  Methods
    reserve : Nat Int;
    inspect : Nat;
    cancel : Nat;
    stock : Nat;
    ready : Nat;
  Gates
    ack : Bool;
    held : Int;
    available : Int;

Body
  Places
    stock_0 : Int;
    phase_0 : Bool;
    reservation_0 : Pair;
    route_0 : Bool;
    permits_0 : Int;
    audit_0 : List;
    stock_1 : Int;
    phase_1 : Bool;
    reservation_1 : Pair;
    route_1 : Bool;
    permits_1 : Int;
    audit_1 : List;
    stock_2 : Int;
    phase_2 : Bool;
    reservation_2 : Pair;
    route_2 : Bool;
    permits_2 : Int;
    audit_2 : List;
    stock_3 : Int;
    phase_3 : Bool;
    reservation_3 : Pair;
    route_3 : Bool;
    permits_3 : Int;
    audit_3 : List;
  Initial
    stock_0 (6), phase_0 (false), reservation_0 ((0, 0)), route_0 (false), permits_0 (1), permits_0 (1), audit_0 ([]), stock_1 (6), phase_1 (false), reservation_1 ((0, 0)), route_1 (false), permits_1 (1), permits_1 (1), audit_1 ([]), stock_2 (6), phase_2 (false), reservation_2 ((0, 0)), route_2 (false), permits_2 (1), permits_2 (1), audit_2 ([]), stock_3 (6), phase_3 (false), reservation_3 ((0, 0)), route_3 (false), permits_3 (1), permits_3 (1), audit_3 ([]);
  Axioms
    reserve_0_false: reserve w q With this.ack (true) ::
      w == 0 and not busy and q > 0 and q <= s and (q <= 2 or q >= 3) and k > 0 => stock_0 s, phase_0 busy, reservation_0 old, route_0 oldRoute, permits_0 k, permits_0 k -> stock_0 (s - q), phase_0 (true), reservation_0 ((q, k)), route_0 (false);
    reserve_0_true: reserve w q With this.ack (true) ::
      w == 0 and not busy and q > 0 and q <= s and (q <= 2 or q >= 3) and k > 0 => stock_0 s, phase_0 busy, reservation_0 old, route_0 oldRoute, permits_0 k, permits_0 k -> stock_0 (s - q), phase_0 (true), reservation_0 ((q, k)), route_0 (true);
    inspect_0: inspect w With this.held (asInt(fst(r))) ::
      w == 0 and busy => phase_0 busy, reservation_0 r -> phase_0 (busy), reservation_0 (r);
    cancel_0: cancel w With this.ack (true) ::
      w == 0 and busy => phase_0 busy, stock_0 s, reservation_0 r, route_0 route, audit_0 xs -> phase_0 (false), stock_0 (s + asInt(fst(r))), reservation_0 ((0, 0)), route_0 (false), permits_0 (asInt(snd(r))), permits_0 (asInt(snd(r))), audit_0 (append(xs, (route, asInt(snd(r)))));
    report_stock_0: stock w With this.available (s) ::
      w == 0 => stock_0 s -> stock_0 (s);
    ready_0: ready w With this.ack (true) ::
      w == 0 and not busy => phase_0 busy, permits_0 k, permits_0 k -> phase_0 (busy), permits_0 (k), permits_0 (k);
    reserve_1_false: reserve w q With this.ack (true) ::
      w == 1 and not busy and q > 0 and q <= s and (q <= 2 or q >= 3) and k > 0 => stock_1 s, phase_1 busy, reservation_1 old, route_1 oldRoute, permits_1 k, permits_1 k -> stock_1 (s - q), phase_1 (true), reservation_1 ((q, k)), route_1 (false);
    reserve_1_true: reserve w q With this.ack (true) ::
      w == 1 and not busy and q > 0 and q <= s and (q <= 2 or q >= 3) and k > 0 => stock_1 s, phase_1 busy, reservation_1 old, route_1 oldRoute, permits_1 k, permits_1 k -> stock_1 (s - q), phase_1 (true), reservation_1 ((q, k)), route_1 (true);
    inspect_1: inspect w With this.held (asInt(fst(r))) ::
      w == 1 and busy => phase_1 busy, reservation_1 r -> phase_1 (busy), reservation_1 (r);
    cancel_1: cancel w With this.ack (true) ::
