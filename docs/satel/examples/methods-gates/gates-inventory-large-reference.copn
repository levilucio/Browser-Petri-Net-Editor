    report_stock_1: stock w With this.available (s) ::
      w == 1 => stock_1 s -> stock_1 (s);
    ready_1: ready w With this.ack (true) ::
      w == 1 and not busy => phase_1 busy, permits_1 k, permits_1 k -> phase_1 (busy), permits_1 (k), permits_1 (k);
    reserve_2_false: reserve w q With this.ack (true) ::
      w == 2 and not busy and q > 0 and q <= s and (q <= 2 or q >= 3) and k > 0 => stock_2 s, phase_2 busy, reservation_2 old, route_2 oldRoute, permits_2 k, permits_2 k -> stock_2 (s - q), phase_2 (true), reservation_2 ((q, k)), route_2 (false);
    reserve_2_true: reserve w q With this.ack (true) ::
