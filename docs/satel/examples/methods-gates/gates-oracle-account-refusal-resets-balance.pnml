<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="balance"><name><text>balance</text></name><graphics><position x="420" y="300"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>0</apn:text></apn:token></apn:valueTokens></place><transition id="deposit"><name><text>deposit(n)</text></name><graphics><position x="180" y="100"/></graphics></transition><transition id="withdrawAccepted"><name><text>withdraw(n): pay</text></name><graphics><position x="180" y="240"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &lt;= b</apn:text></apn:guard></transition><transition id="withdrawRefused"><name><text>withdraw(n): refuse</text></name><graphics><position x="180" y="360"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &gt; b</apn:text></apn:guard></transition><transition id="withdrawAll"><name><text>withdrawAll()</text></name><graphics><position x="180" y="480"/></graphics></transition><transition id="query"><name><text>query()</text></name><graphics><position x="480" y="540"/></graphics></transition><arc id="balance-deposit" source="balance" target="deposit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="deposit-balance" source="deposit" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b + n</apn:text></apn:binding></arc><arc id="balance-withdrawAccepted" source="balance" target="withdrawAccepted"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="withdrawAccepted-balance" source="withdrawAccepted" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b - n</apn:text></apn:binding></arc><arc id="balance-withdrawRefused" source="balance" target="withdrawRefused"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="withdrawRefused-balance" source="withdrawRefused" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>0</apn:text></apn:binding></arc><arc id="balance-withdrawAll" source="balance" target="withdrawAll"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="withdrawAll-balance" source="withdrawAll" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>0</apn:text></apn:binding></arc><arc id="balance-query" source="balance" target="query"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc><arc id="query-balance" source="query" target="balance"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>b</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"balance","sort":"Nat","io_type":"internal"}],"transitions":[{"id":"deposit","method":{"name":"deposit","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["1"]}]},{"id":"withdrawAccepted","method":{"name":"withdraw","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["1"]},{"gate":"paidAmount","arguments":["n"]}]},{"id":"withdrawRefused","method":{"name":"withdraw","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["0"]}]},{"id":"withdrawAll","method":{"name":"withdrawAll","parameters":[]},"gates":[{"gate":"ack","arguments":["1"]},{"gate":"paidAmount","arguments":["b"]}]},{"id":"query","method":{"name":"query","parameters":[]},"gates":[{"gate":"balanceResult","arguments":["b"]}]}],"gates":[{"name":"ack","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"paidAmount","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"balanceResult","parameters":[{"name":"arg1","sort":"Nat"}]}],"apnClass":"oracle_account_refusal_resets_balance","testIntentions":[{"id":"account-refined","kind":"symbolic","name":"Account — less / equal / greater","description":"Editable equation-derived withdrawal classes and stimulation/observation pair protocol.","symbolic":{"source":"constructor All() : Request\nconstructor Amount(Nat) : Request\nconstructor Paid(Nat) : Reply\nconstructor Refused(Nat) : Reply\nconstructor Result(Nat, Reply) : WithdrawalResult\noperation affordable(Nat, Nat) : Bool\noperation withdraw(Nat, Request) : WithdrawalResult\n\nrule affordable.less(n: Nat, b: Nat): affordable(n, b) = true if (n &lt; b)\nrule affordable.equal(n: Nat, b: Nat): affordable(n, b) = true if (n == b)\nrule affordable.greater(n: Nat, b: Nat): affordable(n, b) = false if (n &gt; b)\nrule withdraw.all(b: Nat): withdraw(b, All()) = Result(0, Paid(b))\nrule withdraw.amount.accept(b: Nat, n: Nat): withdraw(b, Amount(n)) = Result((b - n), Paid(n)) if (affordable(n, b) == true)\nrule withdraw.amount.refuse(b: Nat, n: Nat): withdraw(b, Amount(n)) = Result(b, Refused(n)) if (affordable(n, b) == false)","operation":"withdraw","argsText":"10, request","variablesText":"request: Request","conditionsText":"","maxDepth":2,"protocolSource":"# Unmentioned public output places produce no tokens in each pair.\ncase all(b: Nat, remaining: Nat, paid: Nat):\ninputs b, All()\nresult Result(remaining, Paid(paid))\npair deposit(n=b) =&gt; ack(1)\npair withdrawAll() =&gt; ack(1), paidAmount(paid)\npair query() =&gt; balanceResult(remaining)\n\ncase paid(b: Nat, n: Nat, remaining: Nat, paid: Nat):\ninputs b, Amount(n)\nresult Result(remaining, Paid(paid))\npair deposit(n=b) =&gt; ack(1)\npair withdraw(n=n) =&gt; ack(1), paidAmount(paid)\npair query() =&gt; balanceResult(remaining)\n\ncase refused(b: Nat, n: Nat, remaining: Nat, refused: Nat):\ninputs b, Amount(n)\nresult Result(remaining, Refused(refused))\npair deposit(n=b) =&gt; ack(1)\npair withdraw(n=n) =&gt; ack(0)\npair query() =&gt; balanceResult(remaining)"}},{"id":"account-coarse","kind":"symbolic","name":"Account — affordable / unaffordable","description":"Editable equation-derived withdrawal classes and stimulation/observation pair protocol.","symbolic":{"source":"constructor All() : Request\nconstructor Amount(Nat) : Request\nconstructor Paid(Nat) : Reply\nconstructor Refused(Nat) : Reply\nconstructor Result(Nat, Reply) : WithdrawalResult\noperation affordable(Nat, Nat) : Bool\noperation withdraw(Nat, Request) : WithdrawalResult\n\nrule affordable.yes(n: Nat, b: Nat): affordable(n, b) = true if (n &lt;= b)\nrule affordable.no(n: Nat, b: Nat): affordable(n, b) = false if (n &gt; b)\nrule withdraw.all(b: Nat): withdraw(b, All()) = Result(0, Paid(b))\nrule withdraw.amount.accept(b: Nat, n: Nat): withdraw(b, Amount(n)) = Result((b - n), Paid(n)) if (affordable(n, b) == true)\nrule withdraw.amount.refuse(b: Nat, n: Nat): withdraw(b, Amount(n)) = Result(b, Refused(n)) if (affordable(n, b) == false)","operation":"withdraw","argsText":"10, request","variablesText":"request: Request","conditionsText":"","maxDepth":2,"protocolSource":"# Unmentioned public output places produce no tokens in each pair.\ncase all(b: Nat, remaining: Nat, paid: Nat):\ninputs b, All()\nresult Result(remaining, Paid(paid))\npair deposit(n=b) =&gt; ack(1)\npair withdrawAll() =&gt; ack(1), paidAmount(paid)\npair query() =&gt; balanceResult(remaining)\n\ncase paid(b: Nat, n: Nat, remaining: Nat, paid: Nat):\ninputs b, Amount(n)\nresult Result(remaining, Paid(paid))\npair deposit(n=b) =&gt; ack(1)\npair withdraw(n=n) =&gt; ack(1), paidAmount(paid)\npair query() =&gt; balanceResult(remaining)\n\ncase refused(b: Nat, n: Nat, remaining: Nat, refused: Nat):\ninputs b, Amount(n)\nresult Result(remaining, Refused(refused))\npair deposit(n=b) =&gt; ack(1)\npair withdraw(n=n) =&gt; ack(0)\npair query() =&gt; balanceResult(remaining)"}}],"satelExample":{"id":"gates-oracle-account-refusal-resets-balance","name":"Methods &amp; gates — Account mutant: refusal-resets-balance","description":"Refused withdrawal resets the balance to zero.","role":"mutant"}}</apn:satel></net></pnml>