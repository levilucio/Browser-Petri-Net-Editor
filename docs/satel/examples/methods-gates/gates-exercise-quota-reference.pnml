<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml" xmlns:apn="http://example.org/apn"><net xmlns="" id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet" netMode="algebraic"><name><text>Petri Net</text></name><page id="page1"><place id="available"><name><text>available</text></name><graphics><position x="140" y="100"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>10</apn:text></apn:token></apn:valueTokens></place><place id="held"><name><text>held</text></name><graphics><position x="140" y="240"/></graphics><apn:valueTokens xmlns:apn="http://example.org/apn"><apn:token><apn:text>0</apn:text></apn:token></apn:valueTokens></place><transition id="reserve"><name><text>reserve</text></name><graphics><position x="430" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &gt; 0 and n &lt;= free</apn:text></apn:guard></transition><transition id="release"><name><text>release</text></name><graphics><position x="690" y="130"/></graphics><apn:guard xmlns:apn="http://example.org/apn"><apn:text>n &gt; 0 and n &lt;= h</apn:text></apn:guard></transition><transition id="audit"><name><text>audit</text></name><graphics><position x="430" y="330"/></graphics></transition><arc id="reserve-in-available-0" source="available" target="reserve"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>free</apn:text></apn:binding></arc><arc id="reserve-in-held-1" source="held" target="reserve"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>h</apn:text></apn:binding></arc><arc id="reserve-out-available-0" source="reserve" target="available"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>free - n</apn:text></apn:binding></arc><arc id="reserve-out-held-1" source="reserve" target="held"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>h + n</apn:text></apn:binding></arc><arc id="release-in-available-0" source="available" target="release"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>free</apn:text></apn:binding></arc><arc id="release-in-held-1" source="held" target="release"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>h</apn:text></apn:binding></arc><arc id="release-out-available-0" source="release" target="available"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>free + n</apn:text></apn:binding></arc><arc id="release-out-held-1" source="release" target="held"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>h - n</apn:text></apn:binding></arc><arc id="audit-in-available-0" source="available" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>free</apn:text></apn:binding></arc><arc id="audit-in-held-1" source="held" target="audit"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>h</apn:text></apn:binding></arc><arc id="audit-out-available-0" source="audit" target="available"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>free</apn:text></apn:binding></arc><arc id="audit-out-held-1" source="audit" target="held"><graphics><metadata><sourceDirection>north</sourceDirection><targetDirection>south</targetDirection></metadata></graphics><apn:binding xmlns:apn="http://example.org/apn"><apn:text>h</apn:text></apn:binding></arc></page><apn:satel xmlns:apn="http://example.org/apn" version="2">{"places":[{"id":"available","sort":"Nat","io_type":"internal"},{"id":"held","sort":"Nat","io_type":"internal"}],"transitions":[{"id":"reserve","method":{"name":"reserve","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"eligible","arguments":["n &gt; 0 and (n &lt; 4 or n == 7)"]}]},{"id":"release","method":{"name":"release","parameters":[{"name":"n","sort":"Nat"}]},"gates":[{"gate":"ack","arguments":["true"]}]},{"id":"audit","method":{"name":"audit","parameters":[]},"gates":[{"gate":"free","arguments":["free"]},{"gate":"reserved","arguments":["h"]}]}],"gates":[{"name":"eligible","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"ack","parameters":[{"name":"arg1","sort":"Bool"}]},{"name":"free","parameters":[{"name":"arg1","sort":"Nat"}]},{"name":"reserved","parameters":[{"name":"arg1","sort":"Nat"}]}],"apnClass":"exercise_quota_reference","testIntentions":[{"id":"exercise-quota","name":"Resource quota — whole-sequence feasibility (16 pairs)","kind":"symbolic","symbolic":{"source":"operation priority(Nat): Bool\nrule small(n: Nat): priority(n) = true if n &gt; 0 and n &lt; 4\nrule special(n: Nat): priority(n) = true if n == 7\nrule ordinary(n: Nat): priority(n) = false if n &gt;= 4 and n != 7","variablesText":"n: Nat","argsText":"n","operation":"priority","conditionsText":"n &gt; 0 and n &lt;= 8","protocolSource":"case run(n: Nat, ok: Bool):\ninputs n\nresult ok\npair reserve(n=n) =&gt; eligible(ok)\npair audit() =&gt; free(10 - n), reserved(n)\npair release(n=3) =&gt; ack(true)\npair audit() =&gt; free(13 - n), reserved(n - 3)\npair reserve(n=4) =&gt; eligible(false)\npair audit() =&gt; free(9 - n), reserved(n + 1)\npair release(n=n) =&gt; ack(true)\npair audit() =&gt; free(9), reserved(1)\npair reserve(n=1) =&gt; eligible(true)\npair audit() =&gt; free(8), reserved(2)\npair release(n=2) =&gt; ack(true)\npair audit() =&gt; free(10), reserved(0)\npair reserve(n=3) =&gt; eligible(true)\npair audit() =&gt; free(7), reserved(3)\npair release(n=3) =&gt; ack(true)\npair audit() =&gt; free(10), reserved(0)","maxDepth":12},"description":"Repeated reservations/releases; a later release forces n ≥ 3. 3 algebraic classes; 16 stimulation/observation pairs per test."}],"satelExample":{"id":"gates-exercise-quota-reference","name":"Methods &amp; gates — Resource quota reference — 16 pairs","role":"reference","description":"Repeated reservations/releases; a later release forces n ≥ 3."}}</apn:satel></net></pnml>