Class hml_adt_list_reference;

Interface
  Methods
    open : List;
    finish : ;
  Gates
    ack : Bool;
    item : List;

Body
  Places
    state : Int;
    value : List;
  Initial
    state (0), value ([]);
  Axioms
    openA: open x With this.ack (true) ::
      s == 0 => state s, value old -> state (1), value (x);
    openB: open x With this.ack (true) ::
      s == 0 => state s, value old -> state (2), value (x);
    finish: finish With this.ack (true) // this.item (v) ::
      s == 1 or (s == 2 and (length(v) == 1 and asInt(head(v)) >= 3)) => state s, value v -> state (3), value (v);

End hml_adt_list_reference;
