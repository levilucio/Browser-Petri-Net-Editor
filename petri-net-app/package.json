{
  "name": "petri-net-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "symex:bundle:pt": "node tools/node/build-symex-pt-zip.cjs",
    "predev": "npm run symex:bundle:pt",
    "prebuild": "npm run symex:bundle:pt",
    "dev": "vite",
    "build": "vite build",
    "build:pages:prod": "node tools/node/vite-build-with-env.cjs --outDir dist --release production",
    "build:pages:staging": "node tools/node/vite-build-with-env.cjs --outDir dist-staging --release staging",
    "build:pages": "npm run symex:bundle:pt && npm run build:pages:prod && npm run build:pages:staging && node tools/node/merge-pages-dist.cjs",
    "preview": "vite preview",
    "test": "jest --config=jest.config.cjs",
    "test:watch": "jest --config=jest.config.cjs --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --config=playwright.ui.config.js",
    "test:e2e:ui:minimal": "playwright test --ui --config=playwright.minimal.config.js"
  },
  "dependencies": {
    "konva": "^9.2.0",
    "pyodide": "^0.27.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-konva": "^18.2.10",
    "uuid": "^11.1.0",
    "z3-solver": "^4.15.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.1.3",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.15",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.29",
    "tailwindcss": "^3.3.3",
    "vite": "^7.3.0"
  }
}
